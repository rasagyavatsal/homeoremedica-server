{
  "name": "homeoremedica-server",
  "private": true,
  "version": "11.0.1",
  "description": "HomeoRemedica API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test",
    "deploy": "gcloud run deploy homeoremedica --source . --region asia-south1 --project ${GCP_PROJECT:-homeoremedica} --max-instances 1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "firebase-admin": "14.5.0",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
